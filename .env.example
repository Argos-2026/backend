# Copy this file to .env. Use KEY=value without quotes or export.
# OS environment variables take precedence. Restart the app after changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# NAVER API HUB credentials (not NAVER Login or legacy Developers keys)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BRAVE_API_KEY=

# Public hostname served by Caddy. Use localhost for local development.
CADDY_DOMAIN=localhost

# Optional workload limits
ANALYSIS_WORKERS=2
ANALYSIS_QUEUE_CAPACITY=8
ANALYSIS_MAX_JOBS=100
ANALYSIS_TIMEOUT=10m

# Comma-separated exact browser origins; replace with the deployed frontend origin.
# No trailing slash or wildcard. Set empty to disable cross-origin browser access.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
